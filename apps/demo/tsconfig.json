{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@sealwax/zcode-ui-core": ["./../../packages/core/src/index.ts"],
      "@sealwax/zcode-ui-core/utils": ["./../../packages/core/src/lib/utils.ts"],
      "@sealwax/zcode-ui-core/*": ["./../../packages/core/src/components/*"],
      "@sealwax/zcode-ui-theme": ["./../../packages/theme/src/index.ts"],
      "@sealwax/zcode-ui-tokens": ["./../../packages/tokens/src/index.ts"],
      "@sealwax/zcode-ui-ai-elements": ["./../../packages/ai-elements/src/index.ts"],
      "@sealwax/zcode-ui-ai-elements/*": ["./../../packages/ai-elements/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
