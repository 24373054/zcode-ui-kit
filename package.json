{
  "name": "zcode-ui-kit",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @zcode-ui/demo run dev",
    "build": "pnpm -r --filter @zcode-ui/tokens --filter @zcode-ui/theme --filter @zcode-ui/core --filter @zcode-ui/ai-elements run build",
    "build:packages": "pnpm run build",
    "build:demo": "pnpm --filter @zcode-ui/demo run build",
    "typecheck": "pnpm -r --filter @zcode-ui/theme --filter @zcode-ui/core --filter @zcode-ui/ai-elements --filter @zcode-ui/demo run typecheck",
    "test": "vitest run",
    "extract": "node ./scripts/extract.mjs",
    "clean": "pnpm -r --filter @zcode-ui/theme --filter @zcode-ui/core --filter @zcode-ui/ai-elements run clean && rm -rf apps/demo/dist"
  },
  "pnpm": {
    "overrides": {
      "@zcode-ui/tokens": "workspace:*",
      "@zcode-ui/theme": "workspace:*",
      "@zcode-ui/core": "workspace:*",
      "@zcode-ui/ai-elements": "workspace:*"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
